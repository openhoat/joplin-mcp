# Copy to .env and set real values before `docker compose up`.
# The same password feeds PostgreSQL and the MCP server.

POSTGRES_PASSWORD=change-me

# Bearer key required by every MCP and /files call (keep it set: an empty key
# disables authentication).
MCP_API_KEY=change-me

# Optional: the Joplin account the server acts for. When empty, the oldest
# account is used — see `SELECT id, email, created_time FROM users;`
# JOPLIN_USER_ID=

# Optional: base URL advertised in tool output and download links.
# MCP_PUBLIC_URL=http://localhost:8000
